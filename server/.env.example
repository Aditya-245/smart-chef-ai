# Vision provider for ingredient recognition: moondream | openai
# When unset, moondream is used if its key is present, otherwise openai.
VISION_PROVIDER=moondream

# Moondream Cloud API key (default provider)
# Get one at https://moondream.ai/c/cloud/api-keys
MOONDREAM_API_KEY=

# Optional: base URL override (default https://api.moondream.ai/v1)
# MOONDREAM_BASE_URL=https://api.moondream.ai/v1

# Optional: OpenAI fallback key, used when VISION_PROVIDER=openai
# Get one at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Optional: model override for the active provider
# moondream: moondream3.1-9B-A2B (default) | moondream3-preview
# openai: gpt-4o-mini
# VISION_MODEL=moondream3.1-9B-A2B